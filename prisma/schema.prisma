generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum Plan {
  FREE
  PRO
  TEAMS
}

enum Category {
  HEALTH
  FITNESS
  MIND
  WORK
  LEARNING
  SOCIAL
  FINANCE
  CREATIVE
  SPIRITUAL
  OTHER
}

enum Priority {
  ESSENTIAL
  IMPORTANT
  NORMAL
  BONUS
}

enum Frequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum TicketStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum PlayerRank {
  E
  D
  C
  B
  A
  S
  NATIONAL
  MONARCH
}

enum QuestType {
  DAILY
  WEEKLY
  MAIN
  SIDE
  HIDDEN
  BOSS
}

enum QuestStatus {
  ACTIVE
  COMPLETED
  FAILED
  CLAIMED
}

enum DungeonType {
  DEEP_WORK
  STUDY
  FITNESS
  MONK_MODE
  CUSTOM
}

enum DungeonDifficulty {
  NORMAL
  HARD
  EXTREME
  HELL
}

enum ItemRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
  MYTHIC
}

enum ItemType {
  COSMETIC
  BOOSTER
  THEME
  AVATAR
  SKILL_BOOK
  TITLE
  CONSUMABLE
}

enum GuildRole {
  MEMBER
  OFFICER
  LEADER
}

enum SkillType {
  PASSIVE
  ACTIVE
  ULTIMATE
}

enum BattlePassTier {
  FREE
  PREMIUM
}

model User {
  id                String    @id @default(cuid())
  name              String?
  email             String?   @unique
  emailVerified     DateTime?
  image             String?
  password          String?
  role              Role      @default(USER)
  stripeCustomerId  String?
  twoFactorEnabled    Boolean   @default(false)
  twoFactorSecret     String?
  banned              Boolean   @default(false)
  banReason           String?
  failedLoginAttempts Int       @default(0)
  lockoutUntil        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  authenticators   Authenticator[]
  subscription     Subscription?
  habits           Habit[]
  completions      HabitCompletion[]
  userHabitData    UserHabitData?
  achievements     Achievement[]
  userChallenges   UserDailyChallenge[]
  aiMessages       AiMessage[]
  aiMemories       AiMemory[]
  apiUsage         ApiUsage[]
  feedback         Feedback[]
  supportTickets   SupportTicket[]
  auditLogs        AuditLog[]
  notifications    Notification[]
  referralCodes    Referral[]             @relation("Referral_referrer")
  referredUsers    Referral[]             @relation("Referral_referee")
  payments         PaymentHistory[]
  userFeedback     UserFeedback[]

  // RPG System Relations
  playerProfile     PlayerProfile?
  playerStats       PlayerStats?
  quests            PlayerQuest[]
  dungeonRuns       DungeonRun[]
  inventory         PlayerInventory[]
  guildMember       GuildMember?
  playerSkills      PlayerSkill[]
  playerBattlePass  PlayerBattlePass?
  dailyRewards      PlayerDailyReward[]
  evolutionPath     PlayerEvolution?
}

model PlayerProfile {
  id               String     @id @default(cuid())
  userId           String     @unique
  title            String     @default("The Unawakened")
  rank             PlayerRank @default(E)
  totalXp          Int        @default(0)
  coins            Int        @default(0)
  prestigeLevel    Int        @default(0)
  totalQuestsDone  Int        @default(0)
  dungeonsCleared  Int        @default(0)
  monstersDefeated Int        @default(0)
  auraColor        String     @default("#39ff14")
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PlayerStats {
  id          String  @id @default(cuid())
  userId      String  @unique
  strength    Int     @default(1)
  intelligence Int    @default(1)
  discipline  Int     @default(1)
  focus       Int     @default(1)
  endurance   Int     @default(1)
  charisma    Int     @default(1)
  wisdom      Int     @default(1)
  energy      Int     @default(100)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Quest {
  id          String     @id @default(cuid())
  type        QuestType  @default(DAILY)
  title       String
  description String
  requirements Json
  xpReward    Int        @default(50)
  coinReward  Int        @default(10)
  statRewards Json?
  itemReward  String?
  unlocksTitle String?
  isActive    Boolean    @default(true)
  expiresAt   DateTime?
  createdAt   DateTime   @default(now())

  playerQuests PlayerQuest[]
}

model PlayerQuest {
  id          String      @id @default(cuid())
  userId      String
  questId     String
  status      QuestStatus @default(ACTIVE)
  progress    Int         @default(0)
  target      Int         @default(1)
  claimedAt   DateTime?
  createdAt   DateTime    @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@unique([userId, questId])
  @@index([userId])
}

model Dungeon {
  id          String           @id @default(cuid())
  type        DungeonType      @default(DEEP_WORK)
  difficulty  DungeonDifficulty @default(NORMAL)
  name        String
  description String
  durationMin Int              @default(25)
  xpReward    Int              @default(100)
  coinReward  Int              @default(20)
  statReward  String?
  requiredLevel Int            @default(1)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())

  runs DungeonRun[]
}

model DungeonRun {
  id          String     @id @default(cuid())
  userId      String
  dungeonId   String
  completed   Boolean    @default(false)
  durationSec Int        @default(0)
  xpEarned    Int        @default(0)
  coinEarned  Int        @default(0)
  bossKilled  Boolean    @default(false)
  startedAt   DateTime   @default(now())
  completedAt DateTime?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  dungeon Dungeon @relation(fields: [dungeonId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ShopItem {
  id          String    @id @default(cuid())
  name        String
  description String
  type        ItemType  @default(COSMETIC)
  rarity      ItemRarity @default(COMMON)
  price       Int
  effect      Json?
  isLimited   Boolean   @default(false)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  inventory PlayerInventory[]
}

model PlayerInventory {
  id        String   @id @default(cuid())
  userId    String
  itemId    String
  quantity  Int      @default(1)
  isEquipped Boolean @default(false)
  acquiredAt DateTime @default(now())

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  item ShopItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([userId])
}

model Guild {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  logo        String?
  level       Int      @default(1)
  xp          Int      @default(0)
  requiredRank PlayerRank @default(E)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members GuildMember[]
}

model GuildMember {
  id        String    @id @default(cuid())
  guildId   String
  userId    String    @unique
  role      GuildRole @default(MEMBER)
  joinedAt  DateTime  @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([guildId])
}

model Skill {
  id          String    @id @default(cuid())
  name        String
  description String
  type        SkillType @default(PASSIVE)
  effect      Json
  requiredLevel Int     @default(1)
  requiredRank PlayerRank @default(E)
  price       Int       @default(0)
  icon        String    @default("zap")
  createdAt   DateTime  @default(now())

  playerSkills PlayerSkill[]
}

model PlayerSkill {
  id        String   @id @default(cuid())
  userId    String
  skillId   String
  level     Int      @default(1)
  isActive  Boolean  @default(false)
  unlockedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([userId])
}

model BattlePass {
  id          String   @id @default(cuid())
  season      Int
  name        String
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  tiers BattlePassTierDef[]
  players PlayerBattlePass[]
}

model BattlePassTierDef {
  id            String        @id @default(cuid())
  battlePassId  String
  tier          Int
  xpRequired    Int
  freeReward    Json
  premiumReward Json

  battlePass BattlePass @relation(fields: [battlePassId], references: [id], onDelete: Cascade)

  @@index([battlePassId])
}

model PlayerBattlePass {
  id            String         @id @default(cuid())
  userId        String         @unique
  battlePassId  String
  tier          BattlePassTier @default(FREE)
  level         Int            @default(0)
  xp            Int            @default(0)
  claimedTiers  Json           @default("[]")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  battlePass BattlePass @relation(fields: [battlePassId], references: [id], onDelete: Cascade)

  @@index([battlePassId])
}

model PlayerDailyReward {
  id        String   @id @default(cuid())
  userId    String
  day       Int      @default(1)
  claimedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([userId])
}

model PlayerEvolution {
  id        String   @id @default(cuid())
  userId    String   @unique
  path      String   @default("shadow")
  stage     Int      @default(1)
  unlockedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter             Int
  credentialDeviceType String
  credentialBackedUp  Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
  @@index([userId])
}

model Subscription {
  id                    String   @id @default(cuid())
  userId                String   @unique
  stripeSubscriptionId  String?  @unique
  stripeCustomerId      String?
  stripePriceId         String?
  stripeCurrentPeriodEnd DateTime?
  plan                  Plan     @default(FREE)
  status                String   @default("active")
  cancelAtPeriodEnd     Boolean  @default(false)
  trialEnd              DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Habit {
  id             String    @id @default(cuid())
  userId         String
  name           String
  description    String?   @db.Text
  category       Category  @default(OTHER)
  priority       Priority  @default(NORMAL)
  frequency      Frequency @default(DAILY)
  xpReward       Int       @default(5)
  timeToComplete Int       @default(5)
  reminderTime   String?
  isPinned       Boolean   @default(false)
  isArchived     Boolean   @default(false)
  shareToken     String?   @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  completions HabitCompletion[]
  achievements Achievement[]

  @@index([userId])
  @@index([userId, category])
  @@index([userId, isArchived])
}

model HabitCompletion {
  id          String   @id @default(cuid())
  habitId     String
  userId      String
  date        DateTime
  completedAt DateTime @default(now())
  notes       String?  @db.Text

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([habitId])
  @@index([userId])
  @@index([userId, date])
  @@unique([habitId, userId, date])
}

model UserHabitData {
  id                 String    @id @default(cuid())
  userId             String    @unique
  streak             Int       @default(0)
  bestStreak         Int       @default(0)
  totalCompletions   Int       @default(0)
  xp                 Int       @default(0)
  lastCompletionDate DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Achievement {
  id          String    @id @default(cuid())
  habitId     String?
  userId      String
  type        String
  title       String
  description String
  icon        String
  xpReward    Int
  unlockedAt  DateTime?

  habit Habit? @relation(fields: [habitId], references: [id], onDelete: SetNull)
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([habitId])
}

model DailyChallenge {
  id          String   @id @default(cuid())
  date        DateTime
  title       String
  description String
  xpReward    Int
  requirement Json
  isActive    Boolean  @default(true)

  userChallenges UserDailyChallenge[]

  @@index([date])
  @@index([isActive])
}

model UserDailyChallenge {
  id          String    @id @default(cuid())
  userId      String
  challengeId String
  completed   Boolean   @default(false)
  completedAt DateTime?

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge DailyChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
  @@index([userId])
}

model AiMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String
  content   String   @db.Text
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
}

model AiMemory {
  id        String   @id @default(cuid())
  userId    String
  key       String
  value     Json
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
}

model ApiUsage {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String
  tokensUsed Int     @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String
  type      String
  message   String   @db.Text
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SupportTicket {
  id        String       @id @default(cuid())
  userId    String
  subject   String
  message   String       @db.Text
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, read])
  @@index([createdAt])
}

model Referral {
  id           String   @id @default(cuid())
  referrerId   String
  refereeId    String   @unique
  code         String
  rewardGiven  Boolean  @default(false)
  createdAt    DateTime @default(now())

  referrer User @relation("Referral_referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referee  User @relation("Referral_referee", fields: [refereeId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@index([code])
}

model FeatureFlag {
  id          String  @id @default(cuid())
  name        String  @unique
  enabled     Boolean @default(false)
  description String?
}

model PaymentHistory {
  id                  String   @id @default(cuid())
  userId              String
  stripePaymentIntentId String @unique
  amount              Int
  currency            String   @default("usd")
  status              String
  plan                String
  createdAt           DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model Coupon {
  id              String    @id @default(cuid())
  code            String    @unique
  discountPercent Int
  maxUses         Int
  usedCount       Int       @default(0)
  expiresAt       DateTime?
  isActive        Boolean   @default(true)
}

model UserFeedback {
  id        String   @id @default(cuid())
  userId    String
  rating    Int
  category  String
  message   String   @db.Text
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([rating])
}
